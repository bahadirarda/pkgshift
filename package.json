{
  "name": "pkgshift",
  "version": "0.1.0",
  "description": "Polyglot workspace for deterministic, transactional package manager migrations.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "implementations/typescript"
  ],
  "author": "bahadirarda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahadirarda/pkgshift.git"
  },
  "homepage": "https://github.com/bahadirarda/pkgshift#readme",
  "bugs": {
    "url": "https://github.com/bahadirarda/pkgshift/issues"
  },
  "keywords": [
    "package-manager",
    "migration",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "codemod",
    "agent-skill"
  ],
  "scripts": {
    "build": "bun run build:typescript && cargo build --workspace --release",
    "build:typescript": "bun run --cwd implementations/typescript build",
    "check": "bun run check:typescript && bun run check:rust && bun run validate",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:typescript": "bun run --cwd implementations/typescript check",
    "cli": "cargo run -p pkgshift-cli --",
    "cli:typescript": "bun run --cwd implementations/typescript cli",
    "test": "bun run test:typescript && cargo test --workspace",
    "test:typescript": "bun run --cwd implementations/typescript test",
    "typecheck": "bun run --cwd implementations/typescript typecheck",
    "validate": "bun run --cwd implementations/typescript validate"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
