{
  "name": "pkgshift",
  "version": "0.1.0",
  "description": "Agent-first, transactional package manager migrations for JavaScript repositories.",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "author": "bahadirarda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahadirarda/pkgshift.git"
  },
  "homepage": "https://github.com/bahadirarda/pkgshift#readme",
  "bugs": {
    "url": "https://github.com/bahadirarda/pkgshift/issues"
  },
  "keywords": [
    "package-manager",
    "migration",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "codemod",
    "agent-skill"
  ],
  "bin": {
    "pkgshift": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outfile=dist/pkgshift.js",
    "check": "bun run typecheck && bun test && bun run validate",
    "cli": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
