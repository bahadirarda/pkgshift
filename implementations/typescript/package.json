{
  "name": "@bahadirarda/pkgshift-typescript",
  "version": "0.2.0",
  "description": "TypeScript reference implementation of pkgshift.",
  "private": true,
  "type": "module",
  "author": "bahadirarda",
  "bin": {
    "pkgshift-typescript": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outfile=dist/pkgshift.js",
    "check": "bun run typecheck && bun test && bun run validate",
    "cli": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
